POSTGRES_USER=taskhub
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=taskhub
DATABASE_URL=postgresql+asyncpg://taskhub:replace-with-a-local-password@localhost:5433/taskhub
REDIS_URL=redis://localhost:6379/0
TASK_CACHE_TTL_SECONDS=300
REDIS_SOCKET_TIMEOUT=1.0
REDIS_CONNECT_TIMEOUT=1.0
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@taskhub.com
EMAIL_NOTIFICATIONS_ENABLED=true
